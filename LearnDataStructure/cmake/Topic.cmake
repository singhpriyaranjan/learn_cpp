set(COURSE_TOPIC_TEST_SOURCE "${CMAKE_CURRENT_LIST_DIR}/TopicSmokeTest.cpp")

function(add_learning_topic target_name)
    add_executable(${target_name} main.cpp Examples.cpp)
    target_include_directories(${target_name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/solutions.cpp")
        target_sources(${target_name} PRIVATE solutions.cpp)
    endif()
    include(CTest)
    if(BUILD_TESTING)
        add_executable(${target_name}_tests "${COURSE_TOPIC_TEST_SOURCE}" Examples.cpp)
        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/solutions.cpp")
            target_sources(${target_name}_tests PRIVATE solutions.cpp)
        endif()
        target_include_directories(${target_name}_tests PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
        add_test(NAME ${target_name}_invariants COMMAND ${target_name}_tests)
    endif()
endfunction()